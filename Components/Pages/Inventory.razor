@page "/inventory"
@inject HttpClient Http
@rendermode InteractiveServer

<div class="sk-page-header">
    <div>
        <h2 class="sk-page-title">📦 Inventar</h2>
        <p class="sk-page-subtitle">Übersicht über deinen Küchenbestand</p>
    </div>
    <button class="sk-btn sk-btn-primary" @onclick="ShowAddModal">+ Artikel hinzufügen</button>
</div>

@if (items == null)
{
    <div class="sk-loading"><div class="sk-spinner"></div> Inventar wird geladen...</div>
}
else
{
    @if (lowStock.Count > 0)
    {
        <div class="sk-card" style="margin-bottom:1.5rem; border-left:3px solid var(--danger);">
            <div class="sk-card-header">
                <span class="sk-card-title">⚠️ Niedriger Bestand (@lowStock.Count Artikel)</span>
            </div>
            <div style="display:flex; gap:0.5rem; flex-wrap:wrap">
                @foreach (var item in lowStock)
                {
                    <span class="sk-badge sk-badge-red">@item.Ingredient?.Name – @item.CurrentStock @item.Ingredient?.Unit</span>
                }
            </div>
        </div>
    }

    <div class="sk-card">
        <table class="sk-table">
            <thead>
                <tr>
                    <th>Zutat</th>
                    <th>Kategorie</th>
                    <th>Bestand</th>
                    <th>Min.</th>
                    <th>Status</th>
                    <th>Ablaufdatum</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in items)
                {
                    var pct = item.MinimumStock > 0 ? Math.Min(100, (int)(item.CurrentStock / item.MinimumStock * 100)) : 100;
                    var barColor = pct > 60 ? "green" : pct > 30 ? "orange" : "red";
                    <tr>
                        <td style="font-weight:600; color:var(--text-primary)">@item.Ingredient?.Name</td>
                        <td><span class="sk-badge sk-badge-gray">@item.Ingredient?.Category</span></td>
                        <td>@item.CurrentStock @item.Ingredient?.Unit</td>
                        <td>@item.MinimumStock @item.Ingredient?.Unit</td>
                        <td style="min-width:120px">
                            <div class="sk-progress">
                                <div class="sk-progress-bar @barColor" style="width:@(pct)%"></div>
                            </div>
                        </td>
                        <td>
                            @if (item.ExpiryDate.HasValue)
                            {
                                var isExpiring = item.ExpiryDate.Value <= DateTime.UtcNow.AddDays(7);
                                var badgeCss = isExpiring ? "sk-badge sk-badge-red" : "sk-badge sk-badge-gray";
                                <span class="@badgeCss">@item.ExpiryDate.Value.ToString("dd.MM.yyyy")</span>
                            }
                            else
                            {
                                <span style="color:var(--text-muted)">–</span>
                            }
                        </td>
                        <td>
                            <button class="sk-btn-icon" title="Löschen" @onclick="() => DeleteItem(item.Id)">🗑️</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@if (showForm)
{
    <div class="sk-modal-backdrop" @onclick="CloseForm">
        <div class="sk-modal" style="max-width:450px" @onclick:stopPropagation>
            <div class="sk-modal-header">
                <span class="sk-modal-title">Artikel hinzufügen</span>
                <button class="sk-btn-icon" @onclick="CloseForm">✕</button>
            </div>
            <div class="sk-modal-body">
                <div class="sk-form-group">
                    <label class="sk-label">Zutat</label>
                    <select class="sk-select" @bind="formIngredientId">
                        <option value="0">-- Zutat wählen --</option>
                        @if (allIngredients != null)
                        {
                            @foreach (var ing in allIngredients)
                            {
                                <option value="@ing.Id">@ing.Name (@ing.Unit)</option>
                            }
                        }
                    </select>
                </div>
                <div class="sk-form-group">
                    <label class="sk-label">Aktueller Bestand</label>
                    <input class="sk-input" type="number" step="0.1" @bind="formStock" />
                </div>
                <div class="sk-form-group">
                    <label class="sk-label">Mindestbestand</label>
                    <input class="sk-input" type="number" step="0.1" @bind="formMinStock" />
                </div>
                <div class="sk-form-group">
                    <label class="sk-label">Ablaufdatum (optional)</label>
                    <input class="sk-input" type="date" @bind="formExpiry" />
                </div>
            </div>
            <div class="sk-modal-footer">
                <button class="sk-btn sk-btn-outline" @onclick="CloseForm">Abbrechen</button>
                <button class="sk-btn sk-btn-primary" @onclick="SaveItem">Speichern</button>
            </div>
        </div>
    </div>
}

@code {
    private List<InventoryDto>? items;
    private List<InventoryDto> lowStock = new();
    private List<IngDto>? allIngredients;
    private bool showForm;

    private int formIngredientId;
    private decimal formStock = 100;
    private decimal formMinStock = 50;
    private DateTime? formExpiry;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        try
        {
            items = await Http.GetFromJsonAsync<List<InventoryDto>>("api/inventory") ?? new();
            lowStock = items.Where(i => i.CurrentStock <= i.MinimumStock).ToList();
            allIngredients ??= await Http.GetFromJsonAsync<List<IngDto>>("api/ingredients") ?? new();
        }
        catch
        {
            items = new();
        }
    }

    private async Task SaveItem()
    {
        if (formIngredientId == 0) return;
        var item = new { ingredientId = formIngredientId, currentStock = formStock, minimumStock = formMinStock, expiryDate = formExpiry };
        await Http.PostAsJsonAsync("api/inventory", item);
        showForm = false;
        await LoadData();
    }

    private async Task DeleteItem(int id)
    {
        await Http.DeleteAsync($"api/inventory/{id}");
        await LoadData();
    }

    private void ShowAddModal() { showForm = true; }
    private void CloseForm() { showForm = false; }

    public class InventoryDto
    {
        public int Id { get; set; }
        public decimal CurrentStock { get; set; }
        public decimal MinimumStock { get; set; }
        public DateTime? ExpiryDate { get; set; }
        public IngDto? Ingredient { get; set; }
    }

    public class IngDto
    {
        public int Id { get; set; }
        public string Name { get; set; } = "";
        public string Unit { get; set; } = "";
        public string Category { get; set; } = "";
    }
}
